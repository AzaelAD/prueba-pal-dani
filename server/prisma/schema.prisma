// Prisma schema for CuraMed POS - Sistema Médico de Material de Curación

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // Local dev zero-config. Para PostgreSQL cambiar a "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  password      String
  role          String         @default("cajero") // "admin" | "cajero"
  avatar        String?
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sales         Sale[]
  cashShifts    CashShift[]
  activityLogs  ActivityLog[]
}

model Product {
  id            String         @id @default(uuid())
  name          String
  sku           String         @unique
  barcode       String?        @unique
  description   String?
  category      String         // Vendajes, Gasas, Antisépticos, Suturas, Guantes, Instrumental, Ortopedia, Varios
  purchasePrice Float          @default(0)
  salePrice     Float          @default(0)
  currentStock  Int            @default(0)
  minStock      Int            @default(5)
  unit          String         @default("Pza") // Pza, Caja, Paquete, Frasco, Rollo, Metro
  supplier      String?
  image         String?
  status        Boolean        @default(true) // activo / inactivo
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  saleItems     SaleItem[]
}

model Customer {
  id            String         @id @default(uuid())
  name          String
  phone         String?
  email         String?
  rfc           String?
  address       String?
  creditBalance Float          @default(0)
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sales         Sale[]
}

model Sale {
  id            String         @id @default(uuid())
  folio         String         @unique
  customerId    String?
  customer      Customer?      @relation(fields: [customerId], references: [id])
  userId        String
  user          User           @relation(fields: [userId], references: [id])
  subtotal      Float
  discount      Float          @default(0)
  tax           Float          @default(0)
  total         Float
  paymentMethod String         // Efectivo, Tarjeta, Transferencia, Mixto
  amountPaid    Float          @default(0)
  change        Float          @default(0)
  status        String         @default("COMPLETED") // COMPLETED, CANCELLED
  cancelReason  String?
  notes         String?
  cashShiftId   String?
  cashShift     CashShift?     @relation(fields: [cashShiftId], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  items         SaleItem[]
}

model SaleItem {
  id            String         @id @default(uuid())
  saleId        String
  sale          Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId     String
  product       Product        @relation(fields: [productId], references: [id])
  quantity      Int
  unitPrice     Float
  purchasePrice Float          @default(0)
  discount      Float          @default(0)
  subtotal      Float
}

model CashShift {
  id            String         @id @default(uuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id])
  openingAmount Float          @default(0)
  cashSales     Float          @default(0)
  cardSales     Float          @default(0)
  transferSales Float          @default(0)
  withdrawals   Float          @default(0)
  expectedCash  Float          @default(0)
  actualCash    Float?
  difference    Float?
  notes         String?
  status        String         @default("OPEN") // OPEN, CLOSED
  openedAt      DateTime       @default(now())
  closedAt      DateTime?
  sales         Sale[]
  movements     CashMovement[]
}

model CashMovement {
  id          String    @id @default(uuid())
  cashShiftId String
  cashShift   CashShift @relation(fields: [cashShiftId], references: [id], onDelete: Cascade)
  type        String    // INGRESO, RETIRO
  amount      Float
  reason      String
  createdAt   DateTime  @default(now())
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  userName  String
  action    String   // VENTA_CREADA, VENTA_CANCELADA, AJUSTE_STOCK, PRODUCTO_CREADO, CORTE_CAJA, etc.
  details   String
  ip        String?
  createdAt DateTime @default(now())
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
